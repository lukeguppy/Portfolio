{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Luke Guppy's Portfolio site using Eleventy",
  "scripts": {
    "build": "node -e \"require('./build/assets').buildAssets({ minify: true })\" && eleventy",
    "dev": "eleventy --serve --port=8080",
    "serve": "eleventy --serve --port=8080",
    "preview": "npm run build && node tools/preview.mjs",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "esbuild": "^0.27.4"
  },
  "author": "Luke Guppy",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/literata": "^5.2.8",
    "@fontsource-variable/overpass": "^5.2.8"
  }
}
