<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#030712">
    <title>{% if title and title != "Home" %}{{ title }} · {% endif %}{{ site.author }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/styles/main.css' | url }}?v=genesis3">
    {% if pageCss %}<link rel="stylesheet" href="{{ ('/assets/styles/pages/' + pageCss + '.css') | url }}?v=genesis3">{% endif %}
    {% if legacyStyle %}<link rel="stylesheet" href="{{ legacyStyle | url }}">{% endif %}
</head>
<body data-chrome="{{ chrome or 'default' }}"{% if pageCss %} data-page="{{ pageCss }}"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
        {% include "site-header.njk" %}
        <main id="main">
            {{ content | safe }}
        </main>
        {% if not hideFooter %}{% include "site-footer.njk" %}{% endif %}
    </div>
    <script type="module" src="{{ '/assets/scripts/main.js' | url }}"></script>
    {% if pageJs %}<script type="module" src="{{ ('/assets/scripts/pages/' + pageJs + '.js') | url }}"></script>{% endif %}
    {% for script in legacyScripts %}<script src="{{ script | url }}"></script>
    {% endfor %}
</body>
</html>
