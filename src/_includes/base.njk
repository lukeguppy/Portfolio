<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title and title != "Home" %}{{ title }} · {% endif %}{{ site.author }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="preload" href="{{ '/assets/fonts/overpass-latin-wght-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ '/assets/fonts/literata-latin-wght-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ '/assets/styles/main.css' | url }}">
    {% if pageCss %}<link rel="stylesheet" href="{{ ('/assets/styles/pages/' + pageCss + '.css') | url }}">{% endif %}
    {% if legacyStyle %}<link rel="stylesheet" href="{{ legacyStyle | url }}">{% endif %}
</head>
<body data-chrome="{{ chrome or 'default' }}"{% if pageCss %} data-page="{{ pageCss }}"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
        {% include "site-header.njk" %}
        <main id="main">
            {{ content | safe }}
        </main>
        {% if not hideFooter %}{% include "site-footer.njk" %}{% endif %}
    </div>
    <script type="module" src="{{ '/assets/scripts/main.js' | url }}"></script>
    {% if pageJs %}<script type="module" src="{{ ('/assets/scripts/pages/' + pageJs + '.js') | url }}"></script>{% endif %}
    {% for script in legacyScripts %}<script src="{{ script | url }}"></script>
    {% endfor %}
</body>
</html>